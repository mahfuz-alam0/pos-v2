{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "POS",
  "version": "0.1.0",
  "identifier": "com.pos.desktop",
  "build": {
    "frontendDist": "https://pos-web-v2.bleaum.dev/",
    "devUrl": "https://pos-web-v2.bleaum.dev/"
  },
  "app": {
    "windows": [
      {
        "title": "POS",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
